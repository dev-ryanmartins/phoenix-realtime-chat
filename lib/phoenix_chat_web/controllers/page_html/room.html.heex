<main
  data-chat-shell
  data-user-id={@user.id}
  data-topic={"room:#{@room.slug}"}
  class="min-h-screen bg-[#f7faf9] text-slate-900 dark:bg-[#071313] dark:text-slate-100"
>
  <div class="mx-auto flex min-h-screen max-w-[1600px]">
    <aside class="hidden w-72 shrink-0 flex-col border-r border-slate-200/80 bg-white/75 px-5 py-6 dark:border-white/10 dark:bg-white/[0.03] md:flex">
      <div class="flex items-center gap-3 px-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-950 font-black text-teal-300 dark:bg-teal-300 dark:text-slate-950">
          L
        </div>
        <div>
          <p class="font-bold tracking-tight">lume</p>
          <p class="text-[11px] text-slate-400">seu espaço compartilhado</p>
        </div>
      </div>

      <div class="mt-12 flex items-center justify-between px-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">
          salas públicas
        </p>
        <span class="rounded-full bg-teal-50 px-2 py-1 text-[10px] font-bold text-teal-700 dark:bg-teal-400/10 dark:text-teal-300">{length(
          @rooms
        )}</span>
      </div>
      <nav class="mt-4 space-y-1">
        <%= for room <- @rooms do %>
          <a
            href={~p"/chat/#{room.slug}"}
            class={[
              "group flex items-center gap-3 rounded-2xl px-3 py-3 text-sm transition",
              if(room.slug == @room.slug,
                do:
                  "bg-slate-950 font-semibold text-white shadow-lg shadow-slate-900/10 dark:bg-teal-300 dark:text-slate-950",
                else:
                  "text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-white/5 dark:hover:text-white"
              )
            ]}
          >
            <span class={[
              "flex h-8 w-8 items-center justify-center rounded-xl text-xs font-bold",
              if(room.slug == @room.slug,
                do: "bg-white/15 dark:bg-slate-950/10",
                else: "bg-slate-100 dark:bg-white/10"
              )
            ]}>#</span>
            <span class="truncate">{room.name}</span>
          </a>
        <% end %>
      </nav>

      <div class="mt-auto rounded-3xl bg-slate-100 p-4 dark:bg-white/5">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-teal-100 text-xs font-bold text-teal-700 dark:bg-teal-400/15 dark:text-teal-300">
            {String.slice(@user.display_name, 0, 2) |> String.upcase()}
          </div>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{@user.display_name}</p>
            <p class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> online agora
            </p>
          </div>
        </div>
        <form action={~p"/logout"} method="post" class="mt-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-500 transition hover:border-rose-200 hover:text-rose-600 dark:border-white/10 dark:bg-transparent dark:text-slate-400 dark:hover:border-rose-500/40 dark:hover:text-rose-300">sair da conta</button>
        </form>
      </div>
    </aside>

    <section class="flex min-w-0 flex-1 flex-col">
      <header class="flex items-center justify-between border-b border-slate-200/80 bg-white/75 px-5 py-4 dark:border-white/10 dark:bg-white/[0.03] sm:px-8">
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-lg font-bold text-teal-600 dark:text-teal-300">#</span>
            <h1 class="truncate text-lg font-bold tracking-tight">{@room.name}</h1>
          </div>
          <div class="mt-1 flex items-center gap-2 text-xs text-slate-400">
            <span>{@room.description}</span>
            <span class="hidden sm:inline">·</span>
            <span data-member-count>conectando...</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span
            data-connection-status
            class="text-xs font-medium text-amber-600 dark:text-amber-300"
          >conectando...</span>
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-50 text-sm font-bold text-teal-700 dark:bg-teal-400/10 dark:text-teal-300">
            {String.slice(@user.display_name, 0, 1) |> String.upcase()}
          </div>
        </div>
      </header>

      <div class="relative flex-1 overflow-y-auto" data-message-scroll>
        <div data-message-list class="min-h-full py-6"></div>
        <div
          data-empty-state
          class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 px-8 text-center"
        >
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-3xl bg-teal-50 text-xl text-teal-600 dark:bg-teal-400/10 dark:text-teal-300">
            ✦
          </div>
          <p class="mt-4 text-sm font-semibold">A sala está tranquila por enquanto.</p>
          <p class="mt-1 text-xs text-slate-400">Diga olá e acenda a conversa.</p>
        </div>
      </div>

      <div class="border-t border-slate-200/80 bg-white/75 p-4 dark:border-white/10 dark:bg-white/[0.03] sm:p-6">
        <form
          data-composer
          class="mx-auto flex max-w-4xl items-end gap-3 rounded-3xl border border-slate-200 bg-white p-2 pl-5 shadow-sm transition focus-within:border-teal-400 focus-within:ring-4 focus-within:ring-teal-100 dark:border-white/10 dark:bg-white/5 dark:focus-within:ring-teal-900/20"
        >
          <input
            data-message-input
            autocomplete="off"
            maxlength="1000"
            placeholder="Escreva uma mensagem..."
            class="min-h-12 flex-1 bg-transparent py-3 text-sm outline-none placeholder:text-slate-400 dark:placeholder:text-slate-600"
          />
          <button
            aria-label="Enviar mensagem"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-slate-950 text-lg text-white transition hover:bg-teal-700 dark:bg-teal-300 dark:text-slate-950 dark:hover:bg-teal-200"
          >↑</button>
        </form>
        <p class="mx-auto mt-3 max-w-4xl px-2 text-[11px] text-slate-400">
          As mensagens são entregues instantaneamente para todos na sala.
        </p>
      </div>
    </section>
  </div>
</main>

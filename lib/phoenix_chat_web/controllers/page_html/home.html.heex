<Layouts.flash_group flash={@flash} />
<main class="min-h-screen overflow-hidden bg-[#f7faf9] text-slate-900 dark:bg-[#071313] dark:text-slate-100">
  <div class="mx-auto grid min-h-screen max-w-7xl lg:grid-cols-[1.05fr_0.95fr]">
    <section class="relative flex flex-col justify-between overflow-hidden px-6 py-8 sm:px-10 lg:px-16 lg:py-12">
      <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-teal-200/50 blur-3xl dark:bg-teal-500/10">
      </div>
      <div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-amber-100/70 blur-3xl dark:bg-amber-500/10">
      </div>
      <header class="relative flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-950 text-lg font-black text-teal-300 shadow-xl shadow-teal-900/10 dark:bg-teal-300 dark:text-slate-950">
          L
        </div>
        <div>
          <p class="text-lg font-bold tracking-tight">lume</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">conversas que ficam acesas</p>
        </div>
      </header>

      <div class="relative max-w-xl py-16 lg:py-0">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/80 px-3 py-1.5 text-xs font-semibold text-teal-700 shadow-sm dark:border-teal-900/60 dark:bg-white/5 dark:text-teal-300">
          <span class="h-2 w-2 animate-pulse rounded-full bg-teal-500"></span>
          conversas em tempo real
        </div>
        <h1 class="max-w-lg text-5xl font-black leading-[0.95] tracking-[-0.06em] sm:text-7xl">
          Um lugar calmo para <span class="text-teal-600 dark:text-teal-300">pensar junto.</span>
        </h1>
        <p class="mt-7 max-w-md text-base leading-7 text-slate-600 dark:text-slate-300">
          Entre em uma sala, encontre sua equipe e veja cada mensagem chegar no instante em que é enviada. Sem ruído, sem espera.
        </p>
        <div class="mt-10 flex flex-wrap gap-3 text-xs font-medium text-slate-500 dark:text-slate-400">
          <span class="rounded-full bg-white px-3 py-2 shadow-sm dark:bg-white/5">salas públicas</span>
          <span class="rounded-full bg-white px-3 py-2 shadow-sm dark:bg-white/5">WebSockets</span>
          <span class="rounded-full bg-white px-3 py-2 shadow-sm dark:bg-white/5">Phoenix PubSub</span>
        </div>
      </div>

      <footer class="relative text-xs text-slate-400 dark:text-slate-500">
        Feito para conversas que merecem espaço.
      </footer>
    </section>

    <section class="relative flex items-center justify-center border-t border-slate-200/80 bg-white/70 px-6 py-12 dark:border-white/10 dark:bg-white/[0.03] sm:px-10 lg:border-l lg:border-t-0 lg:px-20">
      <div class="w-full max-w-md">
        <div class="mb-8">
          <p class="text-sm font-semibold text-teal-600 dark:text-teal-300">comece agora</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight">Qual nome você quer usar?</h2>
          <p class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-400">
            É só um nome de exibição. Não precisa criar senha.
          </p>
        </div>
        <form action={~p"/login"} method="post" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">nome de exibição</span>
            <input
              name="display_name"
              required
              minlength="2"
              maxlength="24"
              autofocus
              placeholder="ex.: Ana Martins"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 text-base outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100 dark:border-white/10 dark:bg-white/5 dark:placeholder:text-slate-600 dark:focus:border-teal-400 dark:focus:bg-white/10 dark:focus:ring-teal-900/30"
            />
          </label>
          <button class="flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-5 py-4 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-teal-700 hover:shadow-xl hover:shadow-teal-900/15 dark:bg-teal-300 dark:text-slate-950 dark:hover:bg-teal-200">
            Entrar no Lume <span aria-hidden="true">→</span>
          </button>
        </form>

        <div class="mt-10 border-t border-slate-200 pt-7 dark:border-white/10">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">
              salas abertas
            </p>
            <span class="text-xs text-slate-400">{length(@rooms)} disponíveis</span>
          </div>
          <div class="mt-4 grid gap-2">
            <%= for room <- @rooms do %>
              <div class="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 dark:border-white/10 dark:bg-white/5">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-50 text-sm font-bold text-teal-700 dark:bg-teal-400/10 dark:text-teal-300">#</span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold">{room.name}</p>
                  <p class="truncate text-xs text-slate-400">{room.description}</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>
